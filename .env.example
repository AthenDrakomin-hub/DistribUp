# DistribUp 分发系统环境配置

# 服务配置
PORT=8080
NODE_ENV=production
BASE_URL=http://localhost:8080

# 数据库
DB_PATH=./data/distribup.db

# JWT 密钥 (生产环境请更改)
JWT_SECRET=distribup_secret_key_change_in_production

# 存储配置 (local/s3/oss)
STORAGE_TYPE=local
# OSS 配置
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=my-app-dist
OSS_ACCESS_KEY_ID=your_access_key
OSS_ACCESS_KEY_SECRET=your_access_secret
# S3 配置
S3_REGION=us-east-1
S3_BUCKET=my-app-dist
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_access_secret

# App Store Connect API
ASC_ISSUER_ID=your_issuer_id
ASC_KEY_ID=your_key_id
ASC_PRIVATE_KEY_PATH=./certs/AuthKey.p8

# zsign 配置
ZSIGN_PATH=/usr/local/bin/zsign
