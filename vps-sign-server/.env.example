# Minimal .env for VPS sign sidecar
# Signing materials are uploaded via the web admin panel; this service pulls them automatically.

PORT=3001
SHARED_SECRET=change-me-to-a-long-random-string
WORKER_URL=https://your-distribup.workers.dev
ZSIGN_PATH=/usr/local/bin/zsign

# R2 S3 credentials (for uploading signed IPA back)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret
R2_BUCKET=distribup-files
