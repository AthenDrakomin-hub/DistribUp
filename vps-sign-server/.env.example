# Fill these in on your VPS at /opt/sign-server/.env
# Then: systemctl enable --now distribup-sign

PORT=3001
SHARED_SECRET=change-me-to-a-long-random-string

# Apple App Store Connect
ASC_ISSUER_ID=YOUR_ISSUER_ID
ASC_KEY_ID=YOUR_KEY_ID
ASC_PRIVATE_KEY=/opt/sign/AuthKey_XXXXXXXXXX.p8

# Signing materials
P12_PATH=/opt/sign/cert.p12
P12_PASSWORD=your-p12-password
MOBILEPROVISION_PATH=/opt/sign/profile.mobileprovision
ZSIGN_PATH=/usr/local/bin/zsign

# R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret
R2_BUCKET=distribup-files
R2_PUBLIC_BASE=https://dl.yourdomain.com
